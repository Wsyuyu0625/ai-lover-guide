"#log{flex:0 0 auto;height:58px;overflow-y:auto;background:#fffafd;border-radius:10px;padding:7px 9px;font-size:11px;line-height:1.5;color:#6b4a56;box-shadow:0 1px 4px rgba(210,140,170,.12)}",
"#talk{flex:0 0 auto;height:70px;overflow-y:auto;background:#fffafd;border-radius:10px;padding:7px 9px;font-size:12px;line-height:1.5;box-shadow:0 1px 4px rgba(210,140,170,.12)}",
"#talk .m{margin:0 0 5px}",
