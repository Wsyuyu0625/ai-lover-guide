"use strict";
// ============================================================
// 大富翁 · UI（WebView 棋盘 + 给棋盘的桥）
// 界面只管画和点；规则全在 packages/monopoly_core.js
// 桥：MonoHost.load / roll / buy / skip / ask / say / reset / diag
// 注意：WebView 的桥是“同步”的（只传一个参数、直接拿返回值，回调会被序列化成 null）
// ============================================================

var BOARD_PATH = "/sdcard/Download/Operit/plugins/monopoly/board.json";
var ASK_PATH   = "/sdcard/Download/Operit/plugins/monopoly/ask_y.json";
var DIAG_PATH  = "/sdcard/Download/Operit/plugins/monopoly/diag.log";

var CORE = (typeof require === "function") ? require("../packages/monopoly_core.js") : null;
if (!CORE) { CORE = { newState: function () { throw new Error("core 未加载"); }, rollDie: function () { return 1; } }; }

async function readText(path) {
    try {
        var raw = await Tools.Files.read(path);
        var content = typeof raw === "string" ? raw
            : (raw && (raw.content || (raw.data && raw.data.content))) || "";
        if (Array.isArray(content)) content = content[0] || "";
        return content || "";
    } catch (e) { return ""; }
}
async function writeText(path, text) {
    try { await Tools.Files.write(path, text); return true; } catch (e) { return false; }
}
async function loadState() {
    var t = await readText(BOARD_PATH);
    if (!t) return null;
    try { var st = JSON.parse(t); if (typeof st === "string") st = JSON.parse(st); return st; }
    catch (e) { return null; }
}
async function saveState(st) { st.updatedAt = Date.now(); return await writeText(BOARD_PATH, JSON.stringify(st, null, 2)); }

var PLACES_JS = '[{"name":"起点","type":"start"},{"name":"老街","type":"land","price":200},{"name":"机会","type":"chance"},{"name":"河边","type":"land","price":300},{"name":"老车站","type":"land","price":350},{"name":"机会","type":"chance"},{"name":"大学路","type":"land","price":400},{"name":"罚单","type":"fine","amount":100},{"name":"湖滨道","type":"land","price":500},{"name":"机会","type":"chance"},{"name":"广场","type":"land","price":600},{"name":"老机场","type":"land","price":450},{"name":"机会","type":"chance"},{"name":"花园路","type":"land","price":700},{"name":"所得税","type":"fine","amount":150},{"name":"免费停车","type":"rest"}]';

var CSS_JS = [
"*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}",
"html,body{margin:0;padding:0;height:100%;background:#fff6f9;color:#5a3b46;font-family:-apple-system,'PingFang SC','Noto Sans CJK SC',sans-serif;overflow:hidden;user-select:none}",
"#app{display:flex;flex-direction:column;height:100vh;padding:8px;gap:8px}",
