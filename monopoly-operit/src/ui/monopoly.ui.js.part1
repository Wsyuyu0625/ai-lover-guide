".tk{width:9px;height:9px;border-radius:50%}.tk.a{background:#ee8fb0}.tk.b{background:#9b7fd4}",
"#center{grid-column:2/5;grid-row:2/5;background:#fffafd;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px;gap:4px;text-align:center;box-shadow:0 2px 10px rgba(200,120,150,.18)}",
