"#talk .a i{display:inline-block;font-style:normal;background:#ffd9e6;color:#7a4155;border-radius:10px;padding:3px 8px;max-width:80%}",
"#talk .b i{display:inline-block;font-style:normal;background:#eee6f8;color:#5a4478;border-radius:10px;padding:3px 8px;max-width:80%}",
"#inrow{flex:0 0 auto;display:flex;gap:6px}",
"#said{flex:1;min-width:0;padding:10px;border-radius:10px;border:1px solid #f3d8e0;background:#fffafd;color:#5a3b46;font-family:inherit;font-size:13px}",
"#btnSay{flex:0 0 68px;background:#ee8fb0;color:#fff;border:none;border-radius:10px;font-size:14px}",
