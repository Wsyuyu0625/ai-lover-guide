".who{flex:1;background:#fffafd;border-radius:10px;padding:7px 10px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 4px rgba(210,140,170,.18)}",
".who.act{outline:2px solid #ee8fb0}",
