".cell.start{background:#d9f2e0;border-color:#7fd8a0}",
".cell.rest{background:#e9e0f8;border-color:#ab93dc}",
".cell.lv1{background:#fff6fa;border-color:#f0d9e2}",
".cell.lv2{background:#ffeef4;border-color:#eec8d6}",
".cell.lv3{background:#ffe2ee;border-color:#eab3c8}",
".cell.lv4{background:#ffd3e4;border-color:#e59cba}",
".cell.hereA{border-color:#e0709a}.cell.hereB{border-color:#9b7fd4}",
